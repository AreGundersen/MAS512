# Rosey, kopiert fra ugv_slip_baseline.wbt (ny startpose, customData endret)
DEF ROSEY Robot {
  translation 6.19 -2.5 0.0625
  rotation 0 0 1 -1.5708
  children [
    Pose {
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.9 0.9
            roughness 0.6
            metalness 0
          }
          geometry Mesh {
            url [
              "../meshes/chassis.stl"
            ]
          }
        }
      ]
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.126 0
      }
      device [
        RotationalMotor {
          name "left_wheel_motor"
          maxVelocity 20
        }
        PositionSensor {
          name "left_wheel_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0.126 0
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance DEF WHEEL_APP PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 1
              metalness 0
            }
            geometry DEF DRIVE_WHEEL Cylinder {
              height 0.02529
              radius 0.0625
            }
          }
        ]
        name "left_wheel"
        contactMaterial "wheel"
        boundingObject USE DRIVE_WHEEL
        physics Physics {
          density -1
          mass 1.5
        }
      }
    }
